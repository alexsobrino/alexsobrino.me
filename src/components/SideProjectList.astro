---
import { Image } from 'astro:assets';
import SideProjectStatus from './SideProjectStatus.astro';
import { sideProjectUrl, type SideProject } from '../side-projects';

interface Props {
  sideProjects: SideProject[];
}

const { sideProjects } = Astro.props;
---

<ul class="projects">
  {
    sideProjects.map((sideProject) => (
      <li class:list={['project', { 'project--retired': sideProject.data.retired }]} lang={sideProject.data.lang}>
        <figure class="project__media">
          <Image src={sideProject.data.image} alt={sideProject.data.imageAlt} widths={[208, 416]} sizes="9.5rem" />
        </figure>
        <div>
          <h3 class="project__name">
            <a class="project__link" href={sideProjectUrl(sideProject)}>{sideProject.id}</a>
          </h3>
          <p class="project__desc">{sideProject.data.summary}</p>
        </div>
        <SideProjectStatus sideProject={sideProject} class="project__status" />
      </li>
    ))
  }
</ul>

<style is:global>
  /* Dense listing rows */
  .projects { list-style: none; margin: 0; padding: 0; border-top: 1px dashed var(--rule); }
  .project {
    position: relative;
    display: grid;
    grid-template-columns: 6.5rem minmax(0, 1fr);
    gap: 0.25rem 1rem;
    align-items: start;
    padding: 1rem 0;
    border-bottom: 1px dashed var(--rule);
  }
  @media (min-width: 36rem) {
    .project { grid-template-columns: 9.5rem minmax(0, 1fr) auto; gap: 0 1.25rem; }
  }
  .project__media {
    grid-row: span 2;
    margin: 0;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    border: 1px solid var(--img-border);
    border-radius: 3px;
    background: var(--panel);
  }
  @media (min-width: 36rem) { .project__media { grid-row: auto; } }
  .project__media img { width: 100%; height: 100%; object-fit: cover; }
  .project__name { margin: 0; font-size: 1rem; font-weight: 700; line-height: 1.4; }
  .project__link { text-decoration: none; }
  .project__link::before { content: "./"; color: var(--faint); font-weight: 400; }
  .project__link::after { content: ""; position: absolute; inset: 0; }
  .project__link:focus-visible { outline: none; }
  .project__link:focus-visible::after { outline: 2px solid var(--focus); outline-offset: 2px; }
  .project:hover { background: linear-gradient(to right, transparent, var(--panel) 6rem); }
  .project:hover .project__link { color: var(--accent); }
  .project__desc { margin: 0.15rem 0 0; color: var(--muted); font-size: 0.875rem; line-height: 1.55; }
  /* Where the status badge sits on the card; its look is SideProjectStatus's own */
  .project__status { justify-self: start; grid-column: 2; }
  @media (min-width: 36rem) {
    .project__status { grid-column: 3; grid-row: 1; margin-top: 0.15rem; }
  }

  /* Retired: greyed out (the badge marks itself retired) */
  .project--retired .project__media img { filter: grayscale(1); opacity: 0.5; }
  .project--retired .project__name, .project--retired .project__desc { color: var(--faint); }
</style>
