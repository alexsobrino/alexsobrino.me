---
import { Image } from 'astro:assets';
import SideProjectStatus from '../../components/SideProjectStatus.astro';
import PiecePageLayout from '../../layouts/PiecePageLayout.astro';
import { getSideProjectPaths } from '../../side-projects';
import { sideProjectPlace } from '../../site-map';

export const getStaticPaths = getSideProjectPaths;

const { sideProject } = Astro.props;
const { name, summary, image, imageAlt, url } = sideProject.data;
---

<PiecePageLayout piece={sideProject} title={name} description={summary} lede={summary} place={sideProjectPlace(sideProject)}>
  <Fragment slot="meta">
    <SideProjectStatus sideProject={sideProject} />
    {url && <a href={url}>{new URL(url).host}</a>}
  </Fragment>
  <figure class="page-figure" slot="before-body">
    <Image src={image} alt={imageAlt} widths={[720, 1440]} sizes="(min-width: 46rem) 44rem, 100vw" />
  </figure>
  {url && <p class="outbound" slot="after-body"><a href={url}>Visitar {name} →</a></p>}
</PiecePageLayout>
