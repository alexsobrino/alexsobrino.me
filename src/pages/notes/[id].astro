---
import PiecePageLayout from '../../layouts/PiecePageLayout.astro';
import { formatDate, getNotePaths } from '../../notes';
import { notePlace, tagPlace } from '../../site-map';

export const getStaticPaths = getNotePaths;

const { note } = Astro.props;
---

<PiecePageLayout piece={note} title={note.data.title} description={note.data.description} place={notePlace(note)}>
  <Fragment slot="meta">
    <time datetime={note.data.date.toISOString()}>{formatDate(note.data.date)}</time>
    {
      note.tags.map((tag) => (
        <>
          {' · '}
          <a href={tagPlace(tag).url}>{tag.data.name}</a>
        </>
      ))
    }
  </Fragment>
</PiecePageLayout>
