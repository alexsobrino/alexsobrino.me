---
import { render } from 'astro:content';
import InnerPageLayout from '../../layouts/InnerPageLayout.astro';
import { formatDate, getNotePaths, tagUrl } from '../../notes';

export const getStaticPaths = getNotePaths;

const { note } = Astro.props;
const { Content } = await render(note);
---

<InnerPageLayout title={note.data.title} description={note.data.description} command="cat" back={{ href: '/notes/', label: 'notas' }}>
  <article lang={note.data.lang}>
    <h1 class="page-title">{note.data.title}</h1>
    <p class="page-meta">
      <time datetime={note.data.date.toISOString()}>{formatDate(note.data.date)}</time>
      {
        note.tags.map((tag) => (
          <>
            {' · '}
            <a href={tagUrl(tag)}>{tag.data.name}</a>
          </>
        ))
      }
    </p>
    <div class="prose">
      <Content />
    </div>
  </article>
</InnerPageLayout>
