---
import NoteList from '../../components/NoteList.astro';
import InnerPageLayout from '../../layouts/InnerPageLayout.astro';
import { getNotesNewestFirst } from '../../notes';

const notes = await getNotesNewestFirst();
---

<InnerPageLayout title="Notas" command="ls" back={{ href: '/', label: 'inicio' }}>
  <h1 class="page-title">Notas</h1>
  {
    notes.length === 0 ? (
      <p class="empty">Todavía no hay notas.</p>
    ) : (
      <NoteList notes={notes} class="prose" />
    )
  }
</InnerPageLayout>
