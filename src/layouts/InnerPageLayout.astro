---
import PromptBar from '../components/PromptBar.astro';
import { innerPagePrompt, type InnerPageCommand, type Place } from '../site-map';
import BaseLayout from './BaseLayout.astro';

// The shell of every page but the home page: the prompt bar, a back link and `main` for the content.
// The page brings its own heading, since a Note or Side Project keeps it in its `<article>`.
// A page in the site map passes its place; the others still pass their command and back link.

type Props = { title: string; description?: string } & (
  | { place: Place }
  | { command: InnerPageCommand; back: { href: string; label: string } }
);

const { title, description } = Astro.props;
const { prompt, back } =
  'place' in Astro.props
    ? Astro.props.place
    : { prompt: innerPagePrompt(Astro.url.pathname, Astro.props.command), back: Astro.props.back };
---

<BaseLayout title={title} description={description}>
  <PromptBar path={prompt.path} command={prompt.command} />
  <p class="back"><a href={back.href}>← {back.label}</a></p>
  <main>
    <slot />
  </main>
</BaseLayout>
