---
import PromptBar from '../components/PromptBar.astro';
import type { Place } from '../site-map';
import BaseLayout from './BaseLayout.astro';

// The shell of every page but the home page: the prompt bar, a back link and `main` for the content.
// The page brings its own heading, since a Note or Side Project keeps it in its `<article>`.
// Where the page sits, and so its prompt and back link, comes only from its place in the site map.

interface Props {
  title: string;
  description?: string;
  place: Place;
}

const { title, description, place } = Astro.props;
const { prompt, back } = place;
---

<BaseLayout title={title} description={description}>
  <PromptBar path={prompt.path} command={prompt.command} />
  <p class="back"><a href={back.href}>← {back.label}</a></p>
  <main>
    <slot />
  </main>
</BaseLayout>
